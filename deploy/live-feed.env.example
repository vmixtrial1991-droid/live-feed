# Настройки приложения. Права 640, владелец root:livefeed.

# --- пароль администратора (обязательно поменяйте) -------------------------------
ADMIN_PASSWORD=

# --- адрес, который увидят гости (домен из QR-кода и из консоли) -------------
PUBLIC_BASE_URL=https://example.com

# --- название мероприятия -----------------------------------------------------
FEED_TITLE=Живая лента
FEED_SUBTITLE=Отправьте текст или фото — мы покажем на экране

# --- работа за nginx ---------------------------------------------------------
# адреса, которым можно верить X-Forwarded-For; здесь сам nginx на этой же машине
TRUSTED_PROXIES=127.0.0.1,::1
FORCE_HTTPS=true
COOKIE_SECURE=true

# --- защита от подмены Host-заголовка ----------------------------------------
# оставьте пустым, если хотите принимать любой домен
TRUSTED_HOSTS=example.com,www.example.com
