# Данные приложения: база и загруженные фото
data/

# Настройки сервера с паролем — файл-шаблон в deploy/ безопаснее держать отдельно
*.env
!*.env.example
deploy/live-feed.env

# Секретные ключи и сертификаты
*.pem
*.key
id_rsa*
id_ed25519*
*.pub

__pycache__/
*.pyc
.venv/
venv/
.DS_Store
Thumbs.db

# Архив собирается из самого репозитория, в историю ему не место
*.zip
*.tar.gz

# Суммы в историю кладём: по ним комплект проверяется после копирования на
# другую машину. А вот BUILD.txt с меткой времени меняется при каждой сборке
# и в историю только мусорит.
dist/BUILD.txt
